.superpowers/
__pycache__/
*.pyc
.pytest_cache/

# SQLite database (deployed separately, not in repo per CLAUDE.md)
Complete.db
Complete.db-shm
Complete.db-wal
frontend/Complete.db
frontend/Complete.db-shm
frontend/Complete.db-wal

# Writable troubleshooting-feedback DB (created at runtime, never committed)
feedback.db
feedback.db-shm
feedback.db-wal

# flask_caching filesystem cache
CACHED_PAGES/
frontend/CACHED_PAGES/
.data/

# Docker deployment: local secrets + nginx logs
.env
nginx/logs/

# Real mybibletoolbox-code commentary corpus if staged in-repo (keep the
# empty data/{commentary,strongs} stubs, ignore any real content dropped in)
vendor/mybibletoolbox-code/data/commentary/*
vendor/mybibletoolbox-code/data/strongs/*
!vendor/mybibletoolbox-code/data/commentary/.gitkeep
!vendor/mybibletoolbox-code/data/strongs/.gitkeep

# playwright MCP scratch output
.playwright-mcp/

# manual-verification screenshots (session scratch, not project assets)
/*.png

# built embeddable chatbot-widget bundle (produced by `vite build` via vite.lib.config.ts)
/static/chatbot-widget*
/static/chatbot-widget/
.worktrees/
.DS_Store
