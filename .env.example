# Copy to .env (git-ignored) and fill in.  Consumed by the `chatbot` service
# via `env_file:` in docker-compose.yml.  No real secrets in this example file.

# ─── Chatbot LLM provider ──────────────────────────────────────────────────
# Read by chatbot/ollama_client.py.  LLM_PROVIDER picks the wire protocol:
#   nvidia -> NVIDIA NIM, OpenAI-compatible  (uses the NVIDIA_* vars below)
#   ollama -> Ollama native /api/chat        (uses the OLLAMA_* vars below)
# Unset behaves as "ollama".
LLM_PROVIDER=nvidia

# ─── NVIDIA NIM (hosted build.nvidia.com) ──────────────────────────────────
# Used when LLM_PROVIDER=nvidia.
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
# Model id — browse https://build.nvidia.com/models for options.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# API key (starts "nvapi-"). REQUIRED for LLM_PROVIDER=nvidia.
# Put the real value only in .env, never in .env.example.
NVIDIA_API_KEY=

# ─── Ollama (used when LLM_PROVIDER=ollama) ─────────────────────────────────
# LLM API base URL.
#   local Ollama daemon : http://localhost:11434   (default in code)
#   Ollama Cloud        : https://api.ollama.com/v1
OLLAMA_API_URL=https://api.ollama.com/v1

# Model id.
OLLAMA_MODEL=deepseek-v4-pro:cloud

# API key — REQUIRED when OLLAMA_API_URL is remote/HTTPS; leave blank for a
# local daemon.  Put the real value only in .env, never in .env.example.
OLLAMA_API_KEY=

# ─── Wiring (already set in docker-compose.yml — listed for completeness) ─────
# Where the Flask app proxies /api/bible-chat/*.  Compose sets this per service.
# CHATBOT_BASE_URL=http://chatbot:8020

# Location of the vendored mybibletoolbox-code inside the chatbot image.
# Compose + Dockerfile.chatbot set this; override only if you relocate it.
# MYBIBLETOOLBOX_PATH=/app/vendor/mybibletoolbox-code

# ─── Full-fidelity commentary corpus (optional) ─────────────────────────────
# If you bind-mount the real ~4.4 GB data dir in docker-compose.yml,
# src/config.py auto-detects it at /app/vendor/mybibletoolbox-code/data and no
# env var is needed.  Set this only to point the corpus somewhere else:
# MYBIBLE_DATA_DIR=/app/vendor/mybibletoolbox-code/data

# ─── Troubleshooting feedback (Flask: myproject.py) ─────────────────────────
# Where user-submitted chat reports are stored. Default is a file in the app
# working dir; in Docker this is a mounted volume (see docker-compose.yml).
FEEDBACK_DB_URL=sqlite:///feedback.db
# HTTP Basic credentials for the /admin trajectory viewer and /api/admin/*.
# BOTH must be set for admin access; unset ⇒ admin endpoints return 503.
ADMIN_USER=
ADMIN_PASSWORD=
